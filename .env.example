# PitchMint Mobile — Environment Variables Example
#
# Backend Base API URL (IMPORTANT: Do NOT append /api; mobile API paths include /api internally)
# - Deployed HTTPS backend (default for preview & production): https://pitch-mint-backend.vercel.app
# - Local emulator (Android): http://10.0.2.2:4000
# - Local simulator / Web: http://localhost:4000
# - Physical phone on same Wi-Fi (HTTP): http://<YOUR_COMPUTER_LAN_IP>:4000
# - Physical phone over secure tunnel (HTTPS): https://<YOUR_TUNNEL_DOMAIN>
#
# NOTE: For local development overrides without modifying tracked .env, create .env.local
# (which is ignored by .gitignore).
EXPO_PUBLIC_API_URL=https://pitch-mint-backend.vercel.app

# Personal Demo Credit Top-Up UI Flag:
# - Set to true for internal demo / preview builds to enable dev top-up controls
# - Defaults to true in __DEV__ and false in production builds
EXPO_PUBLIC_ENABLE_DEMO_TOPUP=true

# Cleartext HTTP Traffic Flag (Android):
# - Set to true only in local development (.env.local) when connecting to local HTTP endpoints over Wi-Fi
# - Remains false in production and preview builds to enforce strict HTTPS encryption
EXPO_PUBLIC_ALLOW_CLEARTEXT=false
