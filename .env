# PitchMint Mobile - Development Environment
#
# Base URL options:
# 1. Automatic: 'http://localhost:4000' (dynamically resolved to Metro host on physical phones and 10.0.2.2 on Android emulator)
# 2. Explicit LAN IP (recommended for physical device stability if Metro host detection is bypassed):
#    EXPO_PUBLIC_API_URL=http://10.54.82.173:4000
#
EXPO_PUBLIC_API_URL=http://10.54.82.173:4000
EXPO_PUBLIC_ALLOW_CLEARTEXT=true
