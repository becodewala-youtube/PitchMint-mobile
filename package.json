{
  "name": "pitchmint-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.6",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "export:android": "expo export --platform android",
    "graphify:extract": "python -m graphify extract . --code-only",
    "graphify:html": "python -m graphify export html",
    "graphify:update": "python -m graphify extract . --code-only && python -m graphify cluster-only . && python -m graphify export html"
  },
  "private": true
}
